# Copier ce fichier en `.env` pour le dev local (non chargé automatiquement
# par Django : utiliser `python-dotenv`/`django-environ` ou exporter ces
# variables dans le shell si besoin — en local, aucune n'est obligatoire,
# tout a une valeur par défaut de dev dans settings.py).
#
# Sur Railway, ces variables se configurent dans l'onglet "Variables" du
# service Django (pas de fichier .env sur Railway).

# --- Django ---
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-moi-en-production
# "True" en local, "False" en production (Railway) — LES DEUX DOIVENT ÊTRE
# DÉFINIES EXPLICITEMENT SUR RAILWAY, sans quoi DEBUG reste à True (valeur
# par défaut ci-dessous) et le site entier répond 400 DisallowedHost (vécu en
# prod le 2026-09-03 : RAILWAY_PUBLIC_DOMAIN ne s'est pas résolu tout seul,
# contrairement à ce qui était supposé ici avant).
DEBUG=True
# Domaines séparés par des virgules, sans schéma ni slash final.
# En local : laisser vide (défaut localhost/127.0.0.1).
# En production (Railway) : OBLIGATOIRE, ex.
# "web-production-xxxx.up.railway.app" ou votre domaine personnalisé — ne pas
# compter sur RAILWAY_PUBLIC_DOMAIN pour le faire automatiquement, à définir
# ici même si le code essaie aussi de la lire en bonus.
ALLOWED_HOSTS=

# --- Base de données ---
# Fournie automatiquement par Railway dès qu'un plugin PostgreSQL est
# attaché au service Django — ne pas la définir en local pour garder SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/nom_de_la_base

# --- Site vitrine / app Flutter Web ---
# URL (relative ou absolue) vers laquelle les boutons Connexion/Inscription
# de la vitrine redirigent. "/app/" (défaut) tant que la vitrine et le build
# Flutter Web sont servis par le même service Django.
FLUTTER_APP_URL=/app/
# Numéro de version affiché sous le bouton de téléchargement de l'APK
# (purement informatif, laisser vide si non suivi).
APK_VERSION=

# --- Paiements (PayDunya, toute la CEDEAO) ---
# "simulateur" (défaut, aucun vrai paiement) ou "paydunya" pour activer le
# vrai prestataire une fois les clés ci-dessous renseignées. Carte
# disponible dans les 15 pays CEDEAO (conversion XOF automatique pour les 7
# pays à devise propre, cf. core/constants.py:convertir_vers_xof) ; Mobile
# Money limité aux pays où PayDunya l'opère (BJ/BF/CI/ML/SN/TG).
PAIEMENT_GATEWAY=paydunya
# Commission : 5 % jusqu'à 3 000 000 XOF inclus, puis 4 %.
COMMISSION_AFRIFLOTTE_SEUIL=3000000
COMMISSION_AFRIFLOTTE_TAUX=5.00
COMMISSION_AFRIFLOTTE_TAUX_SUPERIEUR=4.00
PAYDUNYA_MASTER_KEY=**************************
PAYDUNYA_PRIVATE_KEY=**************************
PAYDUNYA_PUBLIC_KEY=**************************
PAYDUNYA_TOKEN=**************************
# "test" (sandbox) ou "live" (réel)
PAYDUNYA_MODE=test
# URL HTTPS publique de ce serveur, utilisée pour les callbacks et redirections
# PayDunya (IPN + retour). DOIT être l'URL réelle de production (Railway,
# domaine public) ; PayDunya ne peut pas joindre 127.0.0.1 ni HTTP en live.
# Exemple de base publique : "https://afriflotte.com"
# L'IPN exact à copier dans PayDunya est :
# https://afriflotte.com/api/payment/ipn/
PAIEMENT_RETOUR_BASE_URL=https://afriflotte.com

# --- Email (réinitialisation de mot de passe) ---
# En local (DEBUG=True), les emails s'affichent dans la console au lieu
# d'être envoyés : ces variables ne sont pas nécessaires pour tester. En
# production, un vrai compte SMTP est OBLIGATOIRE (Gmail, SendGrid, Mailgun,
# AWS SES... n'importe quel service exposant une interface SMTP standard) —
# sans EMAIL_HOST_PASSWORD, aucun code de réinitialisation ne part jamais.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AfriFlotte <no-reply@afriflotte.com>
